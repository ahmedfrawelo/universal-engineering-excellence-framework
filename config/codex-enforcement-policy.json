  "frontendEnforcement": {
    "promptPatterns": [
      "(?i)\\b(frontend|front-end|ui|ux|css|scss|tailwind|react|angular|vue|svelte|page|screen|component|dashboard|landing|responsive|theme|design system|data grid)\\b",
      "[\\u0600-\\u06ff]*(واجهة|فرنت|فورنت|صفحة|شاشة|مكون|تصميم|ألوان|الوان|ثيم|متجاوب|لوحة|جدول)[\\u0600-\\u06ff]*"
    ],
    "metaPromptExclusionPatterns": [
      "(?i)\\bUEEF\\b.{0,80}\\b(frontend|ui|ux)\\b.{0,80}\\b(rule|policy|route|routing|gate|validator|enforcement|framework)\\b",
      "(?i)\\b(frontend|ui|ux)\\b.{0,80}\\b(rule|policy|route|routing|gate|validator|enforcement)\\b.{0,80}\\bUEEF\\b",
      "(?:قواعد|سياسة|توجيه|بوابة|فاحص|إنفاذ|اطار|إطار).{0,40}(?:الفرنت|الفورنت|الواجهة).{0,80}UEEF|UEEF.{0,80}(?:قواعد|سياسة|توجيه|بوابة|فاحص|إنفاذ|اطار|إطار).{0,40}(?:الفرنت|الفورنت|الواجهة)"
    ],
    "routeCommandPattern": "select-frontend-route\\.mjs",
    "evidenceCommandPattern": "validate-frontend-execution-evidence\\.mjs",
    "passingTestCommandPattern": "(?:(?:npm(?:\\.cmd)?|pnpm|yarn|bun)\\s+(?:run\\s+)?test\\b|npx\\s+(?:vitest|jest)\\b|ng\\s+test\\b|dotnet\\s+test\\b|pytest\\b|python(?:\\.exe)?\\s+-m\\s+pytest\\b|cargo\\s+test\\b|go\\s+test\\b|test-|validate-framework|ueef-audit|invoke-full-assurance)"
  },
  "completionClaimPattern": "(?i)(\\bCOMPLETE\\b|\\b100\\s*%|\\bperfect\\b|\\bfully verified\\b|مكتمل|اكتمل|كامل|تم بالكامل)",
  "postCompletionQuestionPattern": "(?i)(\\?|هل تريد|هل تحب|حابب|anything else|do you want|would you like)",
  "destructiveCommands": [
    {"id": "delete", "authorization": "delete", "pattern": "(?i)(Remove-Item|rm\\s+-r|\\bdel(?:ete)?\\s|rmdir|erase\\s|git\\s+branch\\s+-D)"},
    {"id": "reset", "authorization": "reset", "pattern": "(?i)(git\\s+(reset|clean|checkout\\s+--)|Clear-RecycleBin)"},
    {"id": "push", "authorization": "push", "pattern": "(?i)(git\\s+push\\b)"},
    {"id": "release", "authorization": "release", "pattern": "(?i)(publish-github-release|gh\\s+release\\s+create|npm\\s+publish|dotnet\\s+nuget\\s+push)"}
  ]
}
